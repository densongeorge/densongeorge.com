---
import StackDisclosure from "../components/StackDisclosure";
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const linkedInUrl = "https://www.linkedin.com/in/denson-george-925852126/";
---

<BaseLayout
  title="Denson George — Senior Software Engineer"
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="editorial-hero" aria-labelledby="intro-title">
      <div class="hero-main">
        <p class="hero-role">Senior Software Engineer</p>
        <h1 id="intro-title">Denson George</h1>
        <p class="hero-headline">
          Software engineer,
          <em>now mostly babysitting agents.</em>
        </p>
      </div>

      <aside class="hero-aside" aria-label="Current profile">
        <p class="aside-label">Currently</p>
        <p>Managing AI agents at Microsoft.</p>
        <p class="aside-location">Dublin, Ireland</p>
        <a class="text-link" href={linkedInUrl} rel="me">
          LinkedIn
          <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </section>

    <section class="editorial-section" aria-labelledby="current-focus">
      <div class="section-label">
        <span>01</span>
        <p>Current focus</p>
      </div>
      <div class="section-copy">
        <h2 id="current-focus">Engineering still comes first.</h2>
        <p>These days, the work includes managing AI agents.</p>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="working-stack">
      <div class="section-label">
        <span>02</span>
        <p>Working stack</p>
      </div>
      <div class="section-copy stack-copy">
        <h2 id="working-stack">Full stack, end to end.</h2>
        <p>UI, backend services, and the platform they run on.</p>

        <div class="stack-island">
          <StackDisclosure client:only="react">
            <div slot="fallback" class="stack-fallback">
              <strong>UI · Backend · Platform</strong>
              <span>
                React · TypeScript · Fluent UI · C# · .NET · Java · Spring Boot
                · Python · Kubernetes
              </span>
            </div>
          </StackDisclosure>
        </div>
      </div>
    </section>

    <section class="profile-contact" aria-labelledby="contact-title">
      <p class="section-label">Profile</p>
      <div class="contact-content">
        <h2 id="contact-title">That’s the short version.</h2>
        <p>LinkedIn has the verified professional details.</p>
        <a class="text-link" href={linkedInUrl} rel="me">
          View LinkedIn
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
