---
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const linkedInUrl = "https://www.linkedin.com/in/denson-george-925852126/";
const githubUrl = "https://github.com/densongeorge";
---

<BaseLayout
  title="Denson George — Senior Software Engineer"
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="page-hero" aria-labelledby="intro-title">
      <h1 id="intro-title">Denson George</h1>
      <p class="hero-role">Senior Software Engineer · Microsoft · Dublin</p>
      <p class="hero-body">
        I'm a Senior Software Engineer at Microsoft, based in Dublin. Most of my
        work these days involves AI agents — building the infrastructure,
        handling orchestration, and dealing with the kind of edge cases that
        come with systems that act on their own.
      </p>
    </section>

    <section class="prose-section" aria-labelledby="working-on">
      <p class="section-heading" id="working-on">What I work on</p>
      <ul>
        <li>
          Full-stack features — React and TypeScript on the frontend, C#/.NET or
          Java on the backend
        </li>
        <li>AI agent systems — design, orchestration, and reliability</li>
        <li>
          Platform work with Kubernetes, keeping services running at scale
        </li>
      </ul>
    </section>

    <section class="prose-section" aria-labelledby="stack-label">
      <p class="section-heading" id="stack-label">Stack</p>
      <p>
        React, TypeScript, and Fluent UI for interfaces. C# and .NET, Java with
        Spring Boot, and Python on the backend. Kubernetes for platform and
        orchestration.
      </p>
    </section>

    <section class="prose-section" aria-labelledby="writing-label">
      <p class="section-heading" id="writing-label">Writing</p>
      <p>
        I'm planning to start writing here — short pieces on AI agents,
        full-stack engineering decisions, and things I pick up along the way.
        Nothing published yet, but that changes soon.
      </p>
    </section>

    <section class="prose-section" aria-labelledby="connect-label">
      <p class="section-heading" id="connect-label">Connect</p>
      <p>
        Find me on <a class="inline-link" href={linkedInUrl} rel="me"
          >LinkedIn</a
        > or look through my code on <a
          class="inline-link"
          href={githubUrl}
          rel="me">GitHub</a
        >.
      </p>
    </section>
  </div>
</BaseLayout>
