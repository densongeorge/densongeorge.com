---
import StackDisclosure from "../components/StackDisclosure";
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const linkedInUrl = "https://www.linkedin.com/in/denson-george-925852126/";
const githubUrl = "https://github.com/densongeorge";
---

<BaseLayout
  title="Denson George — Senior Full-Stack Software Engineer"
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="editorial-hero" aria-labelledby="intro-title">
      <div class="hero-main">
        <p class="hero-role">Senior Software Engineer</p>
        <h1 id="intro-title">Denson George</h1>
        <p class="hero-headline">
          Full-stack engineering, from interface to platform.
        </p>
      </div>

      <div class="hero-intro">
        <p>
          Hello, I’m Denson. I work across UI, backend services, and platforms,
          with AI agents now part of the engineering work.
        </p>
        <div class="social-links" aria-label="Profile links">
          <a class="text-link" href={linkedInUrl} rel="me">
            LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={githubUrl} rel="me">
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="what-i-do">
      <div class="section-label">
        <span>01</span>
        <p>What I do now</p>
      </div>
      <div class="section-copy">
        <h2 id="what-i-do">Software engineering across the stack.</h2>
        <ul class="work-list">
          <li>
            <span>01</span>
            <div>
              <h3>Full-stack development</h3>
              <p>
                Working across UI, backend services, and the platforms that run
                them.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>AI-agent focus</h3>
              <p>Managing AI agents as part of the current engineering work.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="working-stack">
      <div class="section-label">
        <span>02</span>
        <p>Focus areas</p>
      </div>
      <div class="section-copy stack-copy">
        <h2 id="working-stack">Tools for the whole system.</h2>
        <p>
          A practical stack spanning interfaces, services, and infrastructure.
        </p>

        <div class="stack-island">
          <StackDisclosure client:only="react">
            <div slot="fallback" class="stack-fallback">
              <strong>UI · Backend · Platform</strong>
              <span>
                React · TypeScript · Fluent UI · C# · .NET · Java · Spring Boot
                · Python · Kubernetes
              </span>
            </div>
          </StackDisclosure>
        </div>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="current-role">
      <div class="section-label">
        <span>03</span>
        <p>Current role</p>
      </div>
      <div class="section-copy">
        <h2 id="current-role">A quick snapshot.</h2>
        <dl class="role-card">
          <div class="role-card-primary">
            <dt>Role</dt>
            <dd>Senior Software Engineer</dd>
          </div>
          <div>
            <dt>Company</dt>
            <dd>Microsoft</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Dublin, Ireland</dd>
          </div>
          <div>
            <dt>Current focus</dt>
            <dd>Managing AI agents</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="notes-title">
      <div class="section-label">
        <span>04</span>
        <p>Writing and notes</p>
      </div>
      <div class="section-copy notes-copy">
        <h2 id="notes-title">Notes are coming.</h2>
        <p>
          This will become a place for concise, practical writing. Nothing is
          published yet.
        </p>
        <div class="roadmap-card">
          <p class="roadmap-label">Planned topics</p>
          <p class="roadmap-note">
            Start small: publish a short note here, share the useful summary on
            LinkedIn, and link code on GitHub when there is something public to
            show.
          </p>
          <ul class="roadmap-list">
            <li>
              <span>01</span>
              <p>Engineering notes on implementation details and trade-offs.</p>
            </li>
            <li>
              <span>02</span>
              <p>AI-agent learnings that are appropriate to share publicly.</p>
            </li>
            <li>
              <span>03</span>
              <p>Small architecture snippets without confidential context.</p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section
      class="editorial-section contact-section"
      aria-labelledby="contact-title"
    >
      <div class="section-label">
        <span>05</span>
        <p>Contact</p>
      </div>
      <div class="section-copy">
        <h2 id="contact-title">Find me online.</h2>
        <p>The links below go to my LinkedIn and GitHub profiles.</p>
        <div class="social-links contact-links" aria-label="Contact links">
          <a class="text-link" href={linkedInUrl} rel="me">
            View LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={githubUrl} rel="me">
            View GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
