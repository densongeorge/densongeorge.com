---
import PostList from "../components/PostList.astro";
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
  title="Denson George — Software engineer, now managing AI agents."
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="hero" aria-labelledby="intro-title">
      <p class="eyebrow">Personal site</p>
      <h1 id="intro-title">Denson George</h1>
      <p class="headline">Software engineer, now managing AI agents.</p>
      <p class="hero-summary">
        A home for concise notes on software, AI systems, and the work around
        them.
      </p>
      <a class="text-link" href="/blog/">
        Browse the writing
        <span aria-hidden="true">→</span>
      </a>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="writing-preview" aria-labelledby="recent-writing">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Latest</p>
              <h2 id="recent-writing">Recent writing</h2>
            </div>
            <a class="quiet-link" href="/blog/">
              View all
            </a>
          </div>
          <PostList posts={recentPosts} headingLevel="h3" />
        </section>
      )
    }
  </div>
</BaseLayout>
