---
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const linkedInUrl = "https://www.linkedin.com/in/denson-george-925852126/";
const githubUrl = "https://github.com/densongeorge";
---

<BaseLayout
  title="Denson George — Senior Software Engineer"
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="editorial-hero" aria-labelledby="intro-title">
      <div class="hero-main">
        <p class="hero-role">Senior Software Engineer</p>
        <h1 id="intro-title">Denson George</h1>
        <p class="hero-headline">
          I build software across the stack and currently manage AI agents.
        </p>
      </div>

      <div class="hero-intro">
        <p>
          My work covers user interfaces, backend services, and the platforms
          that keep them running.
        </p>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="what-i-do">
      <div class="section-label">
        <span>01</span>
        <p>My work today</p>
      </div>
      <div class="section-copy">
        <h2 id="what-i-do">I work from the interface to the platform.</h2>
        <ul class="work-list">
          <li>
            <span>01</span>
            <div>
              <h3>Build full-stack software</h3>
              <p>I work on user interfaces and backend services.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Work with the platform</h3>
              <p>Kubernetes is part of the stack I use.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Manage AI agents</h3>
              <p>AI agents are part of my current engineering focus.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="working-stack">
      <div class="section-label">
        <span>02</span>
        <p>Focus areas</p>
      </div>
      <div class="section-copy">
        <h2 id="working-stack">These are the tools I work with.</h2>
        <dl class="focus-list">
          <div>
            <dt>UI</dt>
            <dd>React, TypeScript, Fluent UI</dd>
          </div>
          <div>
            <dt>Backend</dt>
            <dd>C# and .NET; Java and Spring Boot; Python</dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd>Kubernetes</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="current-role">
      <div class="section-label">
        <span>03</span>
        <p>Where I am now</p>
      </div>
      <div class="section-copy">
        <h2 id="current-role">Here’s where I’m working now.</h2>
        <dl class="role-card">
          <div class="role-card-primary">
            <dt>Title</dt>
            <dd>Senior Software Engineer</dd>
          </div>
          <div>
            <dt>Company</dt>
            <dd>Microsoft</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>Dublin, Ireland</dd>
          </div>
          <div>
            <dt>Current focus</dt>
            <dd>Managing AI agents</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="notes-title">
      <div class="section-label">
        <span>04</span>
        <p>What I plan to share</p>
      </div>
      <div class="section-copy notes-copy">
        <h2 id="notes-title">I’m starting a small notes section.</h2>
        <p>
          Nothing is published yet. I plan to begin with short pieces I can make
          genuinely useful.
        </p>
        <div class="roadmap-card">
          <p class="roadmap-label">First topics</p>
          <p class="roadmap-note">
            I’ll publish here first, share a short version on LinkedIn, and add
            code on GitHub when it helps explain the idea.
          </p>
          <ul class="roadmap-list">
            <li>
              <span>01</span>
              <p>Full-stack decisions and trade-offs.</p>
            </li>
            <li>
              <span>02</span>
              <p>
                Practical lessons from managing AI agents that I can share
                publicly.
              </p>
            </li>
            <li>
              <span>03</span>
              <p>
                Small architecture examples, kept clear of confidential context.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section
      class="editorial-section contact-section"
      aria-labelledby="contact-title"
    >
      <div class="section-label">
        <span>05</span>
        <p>Find me</p>
      </div>
      <div class="section-copy">
        <h2 id="contact-title">Let’s stay in touch.</h2>
        <p>You can find me on LinkedIn and GitHub.</p>
        <div class="social-links contact-links" aria-label="Contact links">
          <a class="text-link" href={linkedInUrl} rel="me">
            Connect on LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link text-link-secondary" href={githubUrl} rel="me">
            Open GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
