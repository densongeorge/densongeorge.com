---
import { SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Denson George — Software engineer, now mostly babysits agents"
  description={SITE_DESCRIPTION}
>
  <div class="container">
    <section class="hero" aria-labelledby="intro-title">
      <p class="eyebrow">Portfolio</p>
      <h1 id="intro-title">Denson George</h1>
      <p class="headline">Software engineer, now mostly babysits agents.</p>
      <p class="hero-summary">
        Senior Software Engineer at Microsoft, based in Dublin.
      </p>
      <a
        class="text-link"
        href="https://www.linkedin.com/in/denson-george-925852126/"
        rel="me"
      >
        View LinkedIn
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="portfolio-details" aria-labelledby="current-work">
      <div class="portfolio-heading">
        <p class="eyebrow">Current</p>
        <h2 id="current-work">Software and AI agents.</h2>
      </div>

      <dl class="profile-facts">
        <div>
          <dt>Role</dt>
          <dd>Senior Software Engineer</dd>
        </div>
        <div>
          <dt>Company</dt>
          <dd>Microsoft</dd>
        </div>
        <div>
          <dt>Based</dt>
          <dd>Dublin</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Managing AI agents</dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
